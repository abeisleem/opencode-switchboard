{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-switchboard",
  "version": "0.1.0",
  "description": "OpenCode plugin: a project-grouped switchboard for your sessions that replaces the tab panel — see what's running, what needs you, and park work for later.",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "!src/demo.tsx",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test scripts demo.tsx",
    "demo": "bun --preload @opentui/solid/preload demo.tsx",
    "smoke": "bun run build && node scripts/smoke.mjs && node scripts/smoke.mjs session",
    "build:client": "bun scripts/build-client.ts",
    "smoke:client": "bun run build:client && node scripts/smoke.mjs bundled && node scripts/smoke.mjs bundled session auto && node scripts/smoke.mjs bundled session activate",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepublishOnly": "bun run typecheck && bun test test/model.test.ts test/selection.test.tsx test/panel.test.tsx test/attention.test.ts",
    "bench": "bun test ./bench/panel.bench.tsx",
    "smoke:package": "node scripts/smoke-package.mjs",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "plugin",
    "tabs",
    "sessions",
    "switchboard"
  ],
  "author": "Abe Isleem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abeisleem/opencode-switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/abeisleem/opencode-switchboard/issues"
  },
  "homepage": "https://github.com/abeisleem/opencode-switchboard#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@opencode/client": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "1.3.0",
    "@xterm/headless": "5.5.0",
    "prettier": "3.6.2",
    "solid-js": "1.9.15",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
